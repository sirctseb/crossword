{
  "name": "crosswordio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --colors --env=jest-environment-node ./src",
    "test:rules": "firebase-bolt ../rules.bolt -o ./rules.json && jest --colors --env=jest-environment-node ./rules.test.ts",
    "storybook": "storybook dev -p 6006",
    "generate": "bolt-typegen -r ../rules.bolt -o ./src/firebase/types.ts && prettier --write ./src/firebase/types.ts",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit --project .",
    "deploy": "firebase deploy --only database",
    "start:emulators": "firebase emulators:start"
  },
  "dependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "@firebase-ui/react": "https://github.com/firebase/firebaseui-web/raw/refs/heads/v7-alpha/releases/firebase-ui-react-0.0.1.tgz",
    "@firebase-ui/core": "https://github.com/firebase/firebaseui-web/raw/refs/heads/v7-alpha/releases/firebase-ui-core-0.0.1.tgz",
    "@firebase-ui/styles": "https://github.com/firebase/firebaseui-web/raw/refs/heads/v7-alpha/releases/firebase-ui-styles-0.0.1.tgz",
    "@firebase-ui/translations": "https://github.com/firebase/firebaseui-web/raw/refs/heads/v7-alpha/releases/firebase-ui-translations-0.0.1.tgz",
    "bem-cn": "^3.0.1",
    "firebase": "^11.0.0",
    "next": "14.1.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hotkeys-hook": "^4.5.0",
    "recoil": "^0.7.7",
    "sass": "^1.71.0"
  },
  "devDependencies": {
    "@sirctseb/bolt-typegen": "^2.0.0",
    "@storybook/addon-essentials": "^7.6.16",
    "@storybook/addon-interactions": "^7.6.16",
    "@storybook/addon-links": "^7.6.16",
    "@storybook/addon-onboarding": "^1.0.11",
    "@storybook/blocks": "^7.6.16",
    "@storybook/nextjs": "^7.6.16",
    "@storybook/react": "^7.6.16",
    "@storybook/test": "^7.6.16",
    "@tailwindcss/postcss": "^4.0.14",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-storybook": "^0.8.0",
    "firebase-tools": "^13.4.1",
    "jest": "^29.7.0",
    "postcss": "^8",
    "postcss-load-config": "^6.0.1",
    "storybook": "^7.6.16",
    "tailwindcss": "^4.0.6",
    "ts-jest": "^29.1.2",
    "typescript": "^5"
  }
}